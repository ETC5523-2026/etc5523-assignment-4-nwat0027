data_status != "Unreliable",
grepl("Aggregate bands", age_group)) |>
# Convert year and rate to proper numeric types
mutate(
year = as.numeric(year),
participation_rate = as.numeric(participation_rate),
# Clean up the label text
age_group = stringr::str_remove(age_group, "Age \\(Aggregate bands\\): "))
