install.packages("ellmer")
packageVersion("ellmer")
library(ellmer)
library(dplyr)
library(readr)
reviews <- read_csv("data/steam_reviews.csv", show_col_types = FALSE)
elysium_reviews <- reviews |>
filter(appid == 99999999) |>
pull(review_text)
review_block <- paste0(
seq_along(elysium_reviews), ". ", elysium_reviews,
collapse = "\n"
)
# Schema: this is what forces the LLM to return a fixed shape.
judgement_type <- type_object(
sentiment        = type_string(
"Positive, Neutral, or Negative — the player's TRUE underlying feeling about the game after accounting for sarcasm and ironic praise"
),
sarcasm_detected = type_boolean(
"TRUE if the reviews use ironic / sarcastic praise (negative-sounding words used to convey positive feelings)"
),
core_theme       = type_string(
"A single sentence capturing what players actually feel about the game"
)
)
chat <- chat_groq(
model = "openai/gpt-oss-120b",
system_prompt = "You are a games-industry analyst. Gamers often express deep love for a game by complaining sarcastically about how it has 'ruined their life'. Read between the lines."
)
elysium_judgement <- chat$chat_structured(
paste0(
"Here are user reviews for the game 'Elysium Protocol'. Produce ONE overall judgement that reflects players' true underlying feelings.\n\n",
review_block
),
type = judgement_type
)
elysium_judgement <- chat$chat_structured(
paste0(
"Here are user reviews for the game 'Elysium Protocol'. Produce ONE overall judgement that reflects players' true underlying feelings.\n\n",
review_block
),
type = judgement_type
)
chat <- chat_groq(
model = "openai/gpt-oss-120b",
system_prompt = "You are a games-industry analyst. Gamers often express deep love for a game by complaining sarcastically about how it has 'ruined their life'. Read between the lines."
)
Sys.getenv("GROQ_API_KEY")
